# ── JWT helpers ───────────────────────────────────────────────────────────────

def decode_jwt_email(token):
    try:
        payload = token.split('.')[1]
        payload += '=' * (4 - len(payload) % 4)
        data = json.loads(base64.urlsafe_b64decode(payload))
        return data.get('email') or data.get('sub') or None
    except Exception:
        return None


# ── Keychain helpers ──────────────────────────────────────────────────────────

def keychain_read(service, account):
    result = subprocess.run(
        ["security", "find-generic-password", "-s", service, "-a", account, "-w"],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout.strip())
    except json.JSONDecodeError:
        return None

def keychain_write(service, account, data):
    subprocess.run(
        ["security", "delete-generic-password", "-s", service, "-a", account],
        capture_output=True
    )
    result = subprocess.run(
        ["security", "add-generic-password", "-s", service, "-a", account,
         "-w", json.dumps(data)],
        capture_output=True, text=True
    )
    return result.returncode == 0

def keychain_delete(service, account):
    subprocess.run(
        ["security", "delete-generic-password", "-s", service, "-a", account],
        capture_output=True
    )

def get_active_account():
    result = subprocess.run(
        ["security", "find-generic-password", "-s", ACTIVE_SERVICE],
        capture_output=True, text=True
    )
    match = re.search(r'"acct"<blob>="([^"]+)"', result.stdout)
    return match.group(1) if match else None

def read_active_credentials():
    account = get_active_account()
    if not account:
        return None, None
    return account, keychain_read(ACTIVE_SERVICE, account)

def write_active_credentials(account, data):
    return keychain_write(ACTIVE_SERVICE, account, data)


# ── Index ─────────────────────────────────────────────────────────────────────

def load_index():
    if not os.path.exists(INDEX_FILE):
        return {}
    with open(INDEX_FILE) as f:
        return json.load(f)

def save_index(index):
    with open(INDEX_FILE, "w") as f:
        json.dump(index, f, indent=2)


# ── Usage via AppleScript (runs fetch() inside Chrome's claude.ai tab) ───────

def _fetch_usage_via_applescript(org_id="", timeout=12):
    """Execute fetch() in Chrome's open claude.ai tab. No extension needed. Returns dict or None."""
    # Require Chrome to be running
    r = subprocess.run(["pgrep", "-x", "Google Chrome"], capture_output=True)
    if r.returncode != 0:
        return None

    # Build JS that fetches usage; discovers org_id first if not supplied
    if org_id:
        js_fetch = (
            "(function(){"
            "fetch('https://claude.ai/api/organizations/" + org_id + "/usage',"
            "{credentials:'include',headers:{'Accept':'application/json'}})"
            ".then(function(r){return r.json()})"
            ".then(function(d){window.__ccswitch__=JSON.stringify({ok:true,usage:d,org_id:'" + org_id + "'})})"
            ".catch(function(e){window.__ccswitch__=JSON.stringify({ok:false,error:String(e.message)})});"
            "return 'started';})()"
        )
    else:
        js_fetch = (
            "(function(){"
            "fetch('https://claude.ai/api/account',"
            "{credentials:'include',headers:{'Accept':'application/json'}})"
            ".then(function(r){return r.json()})"
            ".then(function(d){"
            "var oid=d&&d.memberships&&d.memberships[0]&&d.memberships[0].organization&&d.memberships[0].organization.id;"
            "if(!oid){window.__ccswitch__=JSON.stringify({ok:false,error:'no_org_id'});return;}"
            "return fetch('https://claude.ai/api/organizations/'+oid+'/usage',"
            "{credentials:'include',headers:{'Accept':'application/json'}})"
            ".then(function(r){return r.json()})"
            ".then(function(u){window.__ccswitch__=JSON.stringify({ok:true,usage:u,org_id:oid});});})"
            ".catch(function(e){window.__ccswitch__=JSON.stringify({ok:false,error:String(e.message)})});"
            "return 'started';})()"
        )

    js_read  = "typeof window.__ccswitch__!='undefined'?window.__ccswitch__:'__pending__'"
    js_clear = "delete window.__ccswitch__; 'ok'"

    def run_js(js):
        js_escaped = js.replace("\\", "\\\\").replace('"', '\\"')
        script = (
            'tell application "Google Chrome"\n'
            '  set t to missing value\n'
            '  repeat with w in every window\n'
            '    repeat with tt in every tab of w\n'
            '      if URL of tt starts with "https://claude.ai" then\n'
            '        set t to tt\n'
            '        exit repeat\n'
            '      end if\n'
            '    end repeat\n'
            '    if t is not missing value then exit repeat\n'
            '  end repeat\n'
            '  if t is missing value then return "__no_tab__"\n'
            '  return execute t javascript "' + js_escaped + '"\n'
            'end tell'
        )
        return subprocess.run(
            ["osascript", "-e", script],
            capture_output=True, text=True, timeout=timeout
        )

    # Inject the fetch call
    r = run_js(js_fetch)
    if r.returncode != 0:
        if "Apple Events" in r.stderr or "AppleScript" in r.stderr:
            return {"ok": False, "error": "js_apple_events_disabled"}
        return None
    if "__no_tab__" in r.stdout:
        return None

    # Poll for result (up to ~6 seconds)
    deadline = time.time() + 6
    val = "__pending__"
    while time.time() < deadline:
        time.sleep(0.7)
        r = run_js(js_read)
        if r.returncode != 0:
            return None
        val = r.stdout.strip()
        if val and val != "__pending__":
            break

    run_js(js_clear)

    if not val or val == "__pending__":
        return None
    try:
        return json.loads(val)
    except Exception:
        return None


def _fetch_usage_via_extension(org_id="", timeout=5):
    """Try the optional Chrome helper socket (fast path if extension is installed)."""
    if not HELPER_SOCK.exists():
        return None
    try:
        with _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(str(HELPER_SOCK))
            s.sendall(json.dumps({"type": "get_usage", "org_id": org_id}).encode())
            s.shutdown(_socket.SHUT_WR)
            chunks = []
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                chunks.append(chunk)
        return json.loads(b"".join(chunks).decode())
    except Exception:
        return None


def _fetch_usage(org_id=""):
    """Fetch Claude usage. Tries extension socket first (if installed), then AppleScript."""
    result = _fetch_usage_via_extension(org_id)
    if result and result.get("ok"):
        return result
    result = _fetch_usage_via_applescript(org_id)
    if result and result.get("error") == "js_apple_events_disabled":
        if not sys.stdout.isatty():
            return result
        try:
            ans = input("\n  Enable usage display in Chrome? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return result
        if ans == "y":
            subprocess.run(["open", "-a", "Google Chrome"], capture_output=True)
            print()
            print("  In Chrome menu bar:")
            print("  View → Developer → Allow JavaScript from Apple Events")
            print()
            input("  Press Enter after enabling it… ")
            result = _fetch_usage_via_applescript(org_id)
        else:
            print()
    return result


# ── Usage display ─────────────────────────────────────────────────────────────

def _human_until(dt_str):
    try:
        dt   = datetime.fromisoformat(dt_str.replace("Z", "+00:00"))
        secs = int((dt - datetime.now(tz=timezone.utc)).total_seconds())
        if secs <= 0:
            return "resetting..."
        d, r = divmod(secs, 86400)
        h, r = divmod(r, 3600)
        m, _ = divmod(r, 60)
        if d: return f"{d}d {h}h"
        if h: return f"{h}h {m}m"
        return f"{m}m"
    except Exception:
        return "?"

def _bar(util, width=10):
    filled = round(max(0, min(100, int(util))) / 100 * width)
    return "█" * filled + "░" * (width - filled)

def print_usage_for_profile(profile_name):
    index  = load_index()
    org_id = index.get(profile_name, {}).get("org_id", "")
    result = _fetch_usage(org_id)
    if not result or not result.get("ok"):
        return
    # Cache org_id for faster future calls
    returned_org_id = result.get("org_id")
    if returned_org_id and not org_id and profile_name in index:
        index[profile_name]["org_id"] = returned_org_id
        save_index(index)
    usage   = result.get("usage", {})
    five_h  = usage.get("five_hour")
    seven_d = usage.get("seven_day")
    if five_h:
        u = int(five_h.get("utilization", 0))
        print(f"  5h limit : {_bar(u)}  {u:>3}%  resets in {_human_until(five_h.get('resets_at', ''))}")
    if seven_d:
        u = int(seven_d.get("utilization", 0))
        print(f"  7d limit : {_bar(u)}  {u:>3}%  resets in {_human_until(seven_d.get('resets_at', ''))}")


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_list():
    index = load_index()
    if not index:
        print("No saved profiles yet.")
        print("  ccswitch save <name>  →  save current account")
        return

    _, active_creds = read_active_credentials()
    active_profile  = None
    if active_creds:
        active_token = active_creds.get("claudeAiOauth", {}).get("accessToken", "")
        for pname in index:
            pcreds = keychain_read(PROFILES_SERVICE, pname)
            if pcreds and pcreds.get("claudeAiOauth", {}).get("accessToken", "") == active_token:
                active_profile = pname
                break

    print(f"\n{'PROFILE':<18} {'ACCOUNT':<30} {'TYPE':<10} {'SAVED'}")
    print("─" * 72)
    for name, meta in index.items():
        marker = " ◀ active" if name == active_profile else ""
        pcreds = keychain_read(PROFILES_SERVICE, name)
        sub    = pcreds.get("claudeAiOauth", {}).get("subscriptionType", "?") if pcreds else "?"
        print(f"  {name:<16} {meta.get('email','?'):<30} {sub:<10} {meta.get('saved_at','?')}{marker}")
    print()

def cmd_save(name):
    if not name:
        print("Error: profile name required.  ccswitch save <name>")
        sys.exit(1)

    account, creds = read_active_credentials()
    if not creds:
        print("Error: no active credentials found. Run 'claude auth login' first.")
        sys.exit(1)

    oauth      = creds.get("claudeAiOauth", {})
    sub_type   = oauth.get("subscriptionType", "?")
    expires_ms = oauth.get("expiresAt", 0)
    expires_dt = datetime.fromtimestamp(expires_ms / 1000, tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    if not keychain_write(PROFILES_SERVICE, name, creds):
        print("Error: could not write to Keychain.")
        sys.exit(1)

    display_email = decode_jwt_email(oauth.get("accessToken", "")) or account
    index = load_index()
    existing_org_id = index.get(name, {}).get("org_id", "")
    index[name] = {
        "email":            display_email,
        "keychain_account": account,
        "subscription":     sub_type,
        "expires_at":       expires_dt,
        "saved_at":         datetime.now().strftime("%Y-%m-%d %H:%M"),
    }
    if existing_org_id:
        index[name]["org_id"] = existing_org_id
    save_index(index)
    print(f"✓ saved as '{name}' ({display_email}, {sub_type})")

def cmd_use(name):
    if not name:
        print("Error: profile name required.  ccswitch use <name>")
        sys.exit(1)

    index = load_index()
    if name not in index:
        print(f"Error: profile '{name}' not found.")
        print(f"Saved profiles: {', '.join(index.keys()) or 'none'}")
        sys.exit(1)

    creds = keychain_read(PROFILES_SERVICE, name)
    if not creds:
        print(f"Error: credentials for '{name}' not found in Keychain.")
        sys.exit(1)

    keychain_account = index[name].get("keychain_account") or index[name].get("email", name)
    if not write_active_credentials(keychain_account, creds):
        print("Error: could not update active credentials.")
        sys.exit(1)

    print(f"✓ switched to '{name}' ({index[name].get('email', name)})")
    print_usage_for_profile(name)

def cmd_add(name):
    if not name:
        print("Error: profile name required.  ccswitch add <name>")
        sys.exit(1)

    index = load_index()
    if name in index:
        answer = input(f"Profile '{name}' already exists ({index[name].get('email','?')}). Overwrite? [y/N]: ").strip().lower()
        if answer != "y":
            print("Aborted.")
            sys.exit(0)

    print(f"Adding new account as '{name}'...")
    old_account, old_creds = read_active_credentials()
    old_token = (old_creds or {}).get("claudeAiOauth", {}).get("accessToken", "")

    print("Opening browser, please log in...")
    print("(return to this terminal when done)\n")

    result = subprocess.run(["claude", "auth", "login"], text=True)
    if result.returncode != 0:
        print("Error: auth login failed.")
        if old_creds and old_account:
            write_active_credentials(old_account, old_creds)
        sys.exit(1)

    new_account, new_creds = read_active_credentials()
    if not new_creds:
        print("Error: could not read credentials after login.")
        if old_creds and old_account:
            write_active_credentials(old_account, old_creds)
        sys.exit(1)

    new_token = new_creds.get("claudeAiOauth", {}).get("accessToken", "")
    if new_token == old_token:
        print("Error: login was cancelled or the same account was used.")
        sys.exit(1)

    new_display_email = decode_jwt_email(new_token) or new_account
    existing_profile  = next(
        (pname for pname, meta in index.items()
         if meta.get("email") == new_display_email and pname != name),
        None
    )
    if existing_profile:
        print(f"Warning: this account ({new_display_email}) is already saved as '{existing_profile}'.")
        answer = input("Save it again under a new name? [y/N]: ").strip().lower()
        if answer != "y":
            print("Aborted. Restoring previous session...")
            if old_creds and old_account:
                write_active_credentials(old_account, old_creds)
            sys.exit(0)

    if not keychain_write(PROFILES_SERVICE, name, new_creds):
        print("Error: could not write to Keychain.")
        sys.exit(1)

    oauth      = new_creds.get("claudeAiOauth", {})
    sub_type   = oauth.get("subscriptionType", "?")
    expires_ms = oauth.get("expiresAt", 0)
    expires_dt = datetime.fromtimestamp(expires_ms / 1000, tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    index[name] = {
        "email":            new_display_email,
        "keychain_account": new_account,
        "subscription":     sub_type,
        "expires_at":       expires_dt,
        "saved_at":         datetime.now().strftime("%Y-%m-%d %H:%M"),
    }
    save_index(index)
    print(f"\n✓ '{name}' ({new_display_email}, {sub_type}) added and active")

    if old_creds and old_account and old_account != new_account:
        old_display_email = decode_jwt_email(old_token) or old_account
        already_saved = any(m.get("email") == old_display_email for m in index.values())
        if not already_saved:
            print(f"\nPrevious account ({old_display_email}) is now inactive.")
            answer = input("Save it too? (enter a name or press Enter to skip): ").strip()
            if answer:
                if keychain_write(PROFILES_SERVICE, answer, old_creds):
                    old_oauth = old_creds.get("claudeAiOauth", {})
                    index[answer] = {
                        "email":            old_display_email,
                        "keychain_account": old_account,
                        "subscription":     old_oauth.get("subscriptionType", "?"),
                        "saved_at":         datetime.now().strftime("%Y-%m-%d %H:%M"),
                    }
                    save_index(index)
                    print(f"✓ '{answer}' ({old_display_email}) saved")

def cmd_remove(name):
    if not name:
        print("Error: profile name required.  ccswitch remove <name>")
        sys.exit(1)

    index = load_index()
    if name not in index:
        print(f"Error: profile '{name}' not found.")
        sys.exit(1)

    keychain_delete(PROFILES_SERVICE, name)
    del index[name]
    save_index(index)
    print(f"✓ profile '{name}' removed")

def cmd_status():
    account, creds = read_active_credentials()
    if not creds:
        print("\n  No active Claude Code session found.")
        print("  Run 'claude auth login' to authenticate.\n")
        return

    oauth      = creds.get("claudeAiOauth", {})
    sub_type   = oauth.get("subscriptionType", "?")
    tier       = oauth.get("rateLimitTier", "?")
    expires_ms = oauth.get("expiresAt", 0)
    expires_dt = datetime.fromtimestamp(expires_ms / 1000, tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    now_ms     = datetime.now(tz=timezone.utc).timestamp() * 1000
    expired    = expires_ms > 0 and now_ms > expires_ms

    index        = load_index()
    active_token = oauth.get("accessToken", "")
    matched_profile = None
    for pname in index:
        pcreds = keychain_read(PROFILES_SERVICE, pname)
        if pcreds and pcreds.get("claudeAiOauth", {}).get("accessToken", "") == active_token:
            matched_profile = pname
            break

    display_email = decode_jwt_email(active_token) or account
    expiry_label  = f"{expires_dt}  ⚠ EXPIRED" if expired else expires_dt

    print()
    print("  ── Active session ──────────────────────────────")
    print(f"  Account  : {display_email}")
    print(f"  Profile  : {matched_profile or '(not saved)'}")
    print(f"  Plan     : {sub_type} ({tier})")
    print(f"  Expires  : {expiry_label}")
    if matched_profile:
        print_usage_for_profile(matched_profile)

    if not index:
        print()
        print("  No saved profiles. Run: ccswitch save <name>")
        print()
        return

    print()
    print("  ── Saved profiles ──────────────────────────────")
    for name, meta in index.items():
        marker = " ◀" if name == matched_profile else "  "
        pcreds = keychain_read(PROFILES_SERVICE, name)
        sub    = pcreds.get("claudeAiOauth", {}).get("subscriptionType", "?") if pcreds else "?"
        print(f" {marker} {name:<16} {meta.get('email','?'):<28} {sub}")

    print()
    if matched_profile is None:
        print("  Tip: run 'ccswitch save <name>' to save the current session.")
        print()


# ── ccswitch helper ───────────────────────────────────────────────────────────

def cmd_helper(args):
    sub = args[0] if args else "status"
    if sub == "install":
        _helper_install(args[1] if len(args) > 1 else None)
    elif sub == "uninstall":
        _helper_uninstall()
    elif sub == "status":
        _helper_status()
    else:
        print(f"Unknown helper subcommand: '{sub}'")
        print("Usage: ccswitch helper [install <extension-id> | uninstall | status]")
        sys.exit(1)

def _helper_install(ext_id):
    if not ext_id:
        print("Error: extension ID required.\n")
        print("  ccswitch helper install <extension-id>\n")
        print("Steps to get the extension ID:")
        print("  1. Chrome → chrome://extensions → enable Developer mode")
        print("  2. Load unpacked → select the chrome-helper/ folder from the ccswitch repo")
        print("     (or download from: https://github.com/recepzgrmh/ccswitch)")
        print("  3. Copy the 32-character ID shown under the extension name")
        sys.exit(1)

    # Write bridge script
    HELPER_DIR.mkdir(parents=True, exist_ok=True)
    bridge_path = HELPER_DIR / "ccswitch_chrome_bridge.py"
    bridge_path.write_text(_BRIDGE_SCRIPT)
    os.chmod(str(bridge_path), 0o755)
    print(f"✓ bridge  →  {bridge_path}")

    # Write native host manifest
    NATIVE_HOSTS_DIR.mkdir(parents=True, exist_ok=True)
    manifest = {
        "name":            NATIVE_HOST_NAME,
        "description":     "ccswitch Chrome usage bridge",
        "path":            str(bridge_path),
        "type":            "stdio",
        "allowed_origins": [f"chrome-extension://{ext_id}/"],
    }
    manifest_path = NATIVE_HOSTS_DIR / f"{NATIVE_HOST_NAME}.json"
    manifest_path.write_text(json.dumps(manifest, indent=2))
    print(f"✓ manifest →  {manifest_path}")
    print()
    print("✓ Chrome helper installed!")
    print()
    print("Make sure the extension is loaded in Chrome:")
    print("  chrome://extensions → Developer mode → Load unpacked → chrome-helper/")
    print()
    print("Verify everything works: ccswitch doctor")

def _helper_uninstall():
    removed = []
    manifest_path = NATIVE_HOSTS_DIR / f"{NATIVE_HOST_NAME}.json"
    if manifest_path.exists():
        manifest_path.unlink()
        removed.append(str(manifest_path))
    bridge_path = HELPER_DIR / "ccswitch_chrome_bridge.py"
    if bridge_path.exists():
        bridge_path.unlink()
        removed.append(str(bridge_path))
    if removed:
        for r in removed:
            print(f"✓ removed  {r}")
        print("\nChrome extension must be removed manually: chrome://extensions")
    else:
        print("Nothing to remove.")

def _helper_status():
    manifest_path = NATIVE_HOSTS_DIR / f"{NATIVE_HOST_NAME}.json"
    bridge_path   = HELPER_DIR / "ccswitch_chrome_bridge.py"
    sock_ok       = HELPER_SOCK.exists()

    print()
    print("  ── Chrome usage helper ─────────────────────────")
    print(f"  manifest : {'✓ installed' if manifest_path.exists() else '✗ not installed'}")
    print(f"  bridge   : {'✓ installed' if bridge_path.exists() else '✗ not installed'}")
    print(f"  socket   : {'✓ running' if sock_ok else '✗ not running  (open Chrome with the extension loaded)'}")
    print()
    if not manifest_path.exists():
        print("  To install:  ccswitch helper install <extension-id>")
        print()


# ── ccswitch doctor ───────────────────────────────────────────────────────────

def cmd_doctor():
    print()
    print("  ── ccswitch doctor ─────────────────────────────")

    # claude CLI
    r = subprocess.run(["which", "claude"], capture_output=True, text=True)
    print(f"  claude CLI : {'✓ ' + r.stdout.strip() if r.returncode == 0 else '✗ not found'}")

    # active session
    account, creds = read_active_credentials()
    print(f"  session    : {'✓ ' + (decode_jwt_email(creds.get('claudeAiOauth',{}).get('accessToken','')) or account or '?') if creds else '✗ not logged in'}")

    # index
    index = load_index()
    print(f"  profiles   : {len(index)} saved")

    # Chrome running?
    r_chrome = subprocess.run(["pgrep", "-x", "Google Chrome"], capture_output=True)
    chrome_ok = r_chrome.returncode == 0
    print(f"  Chrome     : {'✓ running' if chrome_ok else '✗ not running  (open Chrome for usage display)'}")

    # claude.ai tab open?
    if chrome_ok:
        script = (
            'tell application "Google Chrome"\n'
            '  set t to missing value\n'
            '  repeat with w in every window\n'
            '    repeat with tt in every tab of w\n'
            '      if URL of tt starts with "https://claude.ai" then\n'
            '        set t to tt\n'
            '        exit repeat\n'
            '      end if\n'
            '    end repeat\n'
            '    if t is not missing value then exit repeat\n'
            '  end repeat\n'
            '  if t is missing value then return "__no_tab__"\n'
            '  return "ok"\n'
            'end tell'
        )
        r_tab = subprocess.run(["osascript", "-e", script], capture_output=True, text=True, timeout=6)
        tab_ok = r_tab.returncode == 0 and "__no_tab__" not in r_tab.stdout
        print(f"  claude.ai  : {'✓ tab open' if tab_ok else '✗ no tab  (open https://claude.ai in Chrome)'}")

        if tab_ok:
            print("  usage API  : checking…", end="", flush=True)
            test = _fetch_usage_via_applescript(timeout=12)
            if test and test.get("ok"):
                u5  = test.get("usage", {}).get("five_hour", {}).get("utilization", "?")
                u7  = test.get("usage", {}).get("seven_day", {}).get("utilization", "?")
                print(f"\r  usage API  : ✓ 5h={u5}%  7d={u7}%   ")
            elif (test or {}).get("error") == "js_apple_events_disabled":
                print(f"\r  usage API  : ✗ Chrome → View → Developer → Allow JavaScript from Apple Events")
            else:
                err = (test or {}).get("error", "no response")
                print(f"\r  usage API  : ✗ {err}")
                if "not_logged_into" in err or test is None:
                    print("               → make sure you're logged into claude.ai in Chrome")

    # Optional extension socket
    sock_ok = HELPER_SOCK.exists()
    if sock_ok:
        print(f"  ext socket : ✓ running (optional fast path)")

    print()


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        _banner()
        print(__doc__)
        sys.exit(0)

    if args[0] in ("-v", "--version", "version"):
        print(f"ccswitch {VERSION}")
        sys.exit(0)

    _banner()

    cmd  = args[0]
    rest = args[1:]

    if   cmd == "list":                cmd_list()
    elif cmd == "save":                cmd_save(rest[0] if rest else None)
    elif cmd == "use":                 cmd_use(rest[0] if rest else None)
    elif cmd == "add":                 cmd_add(rest[0] if rest else None)
    elif cmd == "remove":              cmd_remove(rest[0] if rest else None)
    elif cmd in ("status", "current"): cmd_status()
    elif cmd == "helper":              cmd_helper(rest)
    elif cmd == "doctor":              cmd_doctor()
    else:
        print(f"Unknown command: '{cmd}'")
        print("Commands: list, save, use, add, remove, status, helper, doctor")
        sys.exit(1)

if __name__ == "__main__":
    main()
